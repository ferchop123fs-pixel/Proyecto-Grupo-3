# Configuración de ejemplo para el Sistema de Tutorías UPDS
# Copiar este archivo como .env y cambiar los valores para el entorno local.

DB_HOST=db
DB_NAME=tutorias_db
DB_USER=tutorias_user
DB_PASS=cambiar_esta_clave

# Credencial administrativa de MySQL/phpMyAdmin.
DB_ROOT_PASSWORD=cambiar_clave_root

# Usuario utilizado por phpMyAdmin.
PMA_USER=root
